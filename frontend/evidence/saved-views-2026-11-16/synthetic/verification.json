{
  "date": "2026-11-16",
  "base": "http://127.0.0.1:5176/",
  "synthetic": true,
  "backendMutation": false,
  "scope": "Saved-view client contract and UI with every API fulfilled locally. CRUD writes modify only this script memory.",
  "contracts": {
    "reads": "Directory is on demand; scoped pagination is not a full-result claim.",
    "save": "Only committed query and applied table state; fixed editor snapshots, stable create ID, CAS revisions and no automatic write retries.",
    "load": "A confirmed resource snapshot is copied into literal URL/table state, not dynamically bound by saved-view ID.",
    "unknown": "GET reads current resource state, not an exact receipt for the original mutation. No durable unknown-operation journal is claimed.",
    "browser": "Chrome desktop/mobile viewports, synthetic composition and local fixtures are not real-provider, physical-device, Safari or final visual acceptance."
  },
  "checks": [
    {
      "scenario": "startup-navigation",
      "name": "A URL change before the first React navigation subscription initializes the actual project and query",
      "passed": true
    },
    {
      "scenario": "directory",
      "name": "Mount does not read the saved-view directory and opening it reads one scoped page",
      "passed": true
    },
    {
      "scenario": "directory",
      "name": "Load more keeps the denominator and does not claim the first window is the whole result set",
      "passed": true
    },
    {
      "scenario": "committed-save-load",
      "name": "Dirty Basic candidates disable saving with a reason and do not issue writes",
      "passed": true
    },
    {
      "scenario": "committed-save-load",
      "name": "Create saves only committed query and applied table state without changing the URL",
      "passed": true
    },
    {
      "scenario": "committed-save-load",
      "name": "Loading a view copies its snapshot to query and table state with one canonical transition",
      "passed": true
    },
    {
      "scenario": "committed-save-load",
      "name": "Refreshing keeps literal query state without silently binding to a newer resource revision",
      "passed": true
    },
    {
      "scenario": "replace-drafts",
      "name": "Loading against a dirty query requires an explicit Keep or Load decision",
      "passed": true
    },
    {
      "scenario": "replace-drafts",
      "name": "Dirty JQL is not saved or silently replaced",
      "passed": true
    },
    {
      "scenario": "stable-create-and-guard",
      "name": "Local validation and dirty-close protection preserve name and do not submit empty names",
      "passed": true
    },
    {
      "scenario": "stable-create-and-guard",
      "name": "A pending create blocks duplicate submissions and retains its original client ID",
      "passed": true
    },
    {
      "scenario": "cas-conflict",
      "name": "CAS conflict keeps the draft and original revision without automatic overwrite or reads",
      "passed": true
    },
    {
      "scenario": "cas-conflict",
      "name": "Reading latest does not change the draft until explicit replacement is confirmed",
      "passed": true
    },
    {
      "scenario": "dirty-navigation",
      "name": "Native Back preserves a dirty saved-view editor until an explicit discard decision",
      "passed": true
    },
    {
      "scenario": "conflict-save-as",
      "name": "Save as after a rejected CAS is an explicit new resource and preserves the original",
      "passed": true
    },
    {
      "scenario": "unknown-create",
      "name": "A lost create response locks the original ID without retry or replacement-ID writes",
      "passed": true
    },
    {
      "scenario": "unknown-create",
      "name": "Closing an unresolved change keeps its stable ID and exposes reconciliation rather than another write",
      "passed": true
    },
    {
      "scenario": "unknown-create",
      "name": "Reading the same ID is labeled current state, not an exact mutation receipt",
      "passed": true
    },
    {
      "scenario": "delete-and-missing",
      "name": "Deletion uses the selected revision and confirms the server receipt before removing the record",
      "passed": true
    },
    {
      "scenario": "delete-and-missing",
      "name": "A missing detail is reported and never substituted with another saved view",
      "passed": true
    },
    {
      "scenario": "directory-errors",
      "name": "An unavailable backend is an explicit error rather than a success-shaped empty directory",
      "passed": true
    },
    {
      "scenario": "directory-errors",
      "name": "Explicit refresh can recover to a true scoped empty state without fake records",
      "passed": true
    },
    {
      "scenario": "project-unavailable",
      "name": "An unavailable project has specific feedback instead of a generic validation or empty result",
      "passed": true
    },
    {
      "scenario": "invalid-directory",
      "name": "A malformed 2xx directory is an error and cannot enable writes",
      "passed": true
    },
    {
      "scenario": "forbidden-detail",
      "name": "Forbidden detail cannot apply a cached directory snapshot or change query state",
      "passed": true
    },
    {
      "scenario": "detail-race-draft",
      "name": "A draft created while detail is loading still requires replacement confirmation",
      "passed": true
    },
    {
      "scenario": "detail-race-scope",
      "name": "A pending detail from the previous scope cannot apply after project navigation",
      "passed": true
    },
    {
      "scenario": "authorization-priority",
      "name": "A 401 clears cached private saved-view names and pending editor state",
      "passed": true
    },
    {
      "scenario": "non-json-unauthorized",
      "name": "A non-JSON proxy 401 still clears private views and does not replay any mutation",
      "passed": true
    },
    {
      "scenario": "mobile-dark",
      "name": "Mobile dark mode exposes the same real menu and save form without document overflow",
      "passed": true
    },
    {
      "scenario": "mobile-unknown",
      "name": "Mobile unknown creation preserves its stable ID and fits both error and acknowledged-state feedback",
      "passed": true
    },
    {
      "scenario": "mobile-chinese",
      "name": "Chinese mobile uses localized save controls and persists the submitted name without overflow",
      "passed": true
    }
  ],
